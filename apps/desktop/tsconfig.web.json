{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ES2020",
      "ES2022.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "exclude": [
    "preview/*.test.ts",
    "preview/*.spec.ts",
    "preview/plugin.ts",
    "preview/service.ts",
    "preview/verify.ts",
    "preview/report.ts",
    "preview/playwright.config.ts",
    "preview/testing.ts",
    "preview/capture.ts"
  ],
  "include": [
    "preview/**/*",
    "renderer.ts",
    "endpoints.ts",
    "src/renderer/**/*",
    "src/browser.ts",
    "src/startup.ts",
    "src/fonts.ts",
    "src/pdfe.ts",
    "src/delivery.ts",
    "src/vault.ts",
    "src/authentication.ts",
    "src/overlay.ts",
    "src/menu.ts",
    "src/taskcenter.ts",
    "src/approval.ts",
    "src/feedback.ts",
    "src/clipboard.ts",
    "src/picker.ts",
    "src/images.ts",
    "src/subscriptions.ts",
    "src/preferences.ts",
    "src/layout.ts",
    "src/preference-diagnostics.ts",
    "src/requests.ts",
    "src/quiescence.ts",
    "src/navigation.ts",
    "src/onboarding.ts",
    "src/permissions.ts",
    "src/storage.ts",
    "src/notifications.ts",
    "src/attention.ts",
    "src/skills.ts",
    "src/plugins.ts",
    "src/mcp-settings.ts",
    "src/reconfiguration.ts",
    "src/updates.ts",
    "src/window.ts",
    "src/tray.ts",
    "src/locale.ts",
    "src/localization/**/*",
    "src/persistence.ts",
    "src/prompts.ts",
    "src/test-helpers/**/*"
  ]
}
