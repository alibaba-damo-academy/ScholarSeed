  "compilerOptions": {
    "target": "ES2022",
    "types": [
      "node",
      "electron-vite/node"
    ],
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "src/main/**/*",
    "src/attention.ts",
    "src/preload/**/*",
