{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/images.ts",
    "src/feedback.ts",
    "src/picker.ts",
    "src/preferences.ts",
    "src/permissions.ts",
    "src/notifications.ts",
    "src/skills.ts",
    "src/subscriptions.ts",
    "src/updates.ts",
    "src/window.ts",
    "src/locale.ts",
    "endpoints.ts",
    "renderer.ts",
    "electron.vite.config.ts",
    "vite.web.config.ts",
    "src/localization/**/*",
    "src/prompts.ts",
    "src/test-helpers/**/*"
  ]
}
