    "src/navigation.ts",
    "src/permissions.ts",
    "src/notifications.ts",
    "src/skills.ts",
    "src/plugins.ts",
    "src/mcp-settings.ts",
    "src/reconfiguration.ts",
    "src/storage.ts",
    "src/subscriptions.ts",
    "src/updates.ts",
    "src/window.ts",
    "src/tray.ts",
