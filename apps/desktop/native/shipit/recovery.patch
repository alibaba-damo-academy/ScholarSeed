+// Both installed-success and restored-failure launches use the same pinned helper.
+static BOOL launchApplication(NSURL *bundleURL) {
+    if (!bundleURL.isFileURL) return NO;
+    if (@available(macOS 11.0, *)) {
+        static NSString *const helperRelativePath = @"Contents/Frameworks/Squirrel.framework/Resources/ShipIt";
+        NSString *exe = [bundleURL URLByAppendingPathComponent:helperRelativePath].path;
+        posix_spawnattr_t attr;
+        if (posix_spawnattr_init(&attr) != 0) return NO;
+        if (responsibility_spawnattrs_setdisclaim && responsibility_spawnattrs_setdisclaim(&attr, 1) != 0) {
+            posix_spawnattr_destroy(&attr); return NO;
+        }
+        const char *args[] = { exe.fileSystemRepresentation, launchSignal.fileSystemRepresentation, bundleURL.path.fileSystemRepresentation, NULL };
+        pid_t pid = 0;
+        int result = posix_spawn(&pid, exe.fileSystemRepresentation, NULL, &attr, (char *const *)args, environ);
+        posix_spawnattr_destroy(&attr);
+        if (result != 0) return NO;
+        int status = 0;
+        while (waitpid(pid, &status, 0) < 0) { if (errno != EINTR) return NO; }
+        return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+    }
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    return [NSWorkspace.sharedWorkspace launchApplicationAtURL:bundleURL options:NSWorkspaceLaunchDefault configuration:@{} error:NULL] != nil;
+#pragma clang diagnostic pop
 }
 
