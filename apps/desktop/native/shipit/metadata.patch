@@ -17,0 +18,6 @@
+
+@class RACSignal, SQRLShipItRequest;
+
+@interface SQRLInstaller (SCHOLARSEEDPreparation)
+- (RACSignal *)prepareCandidateMetadataForRequest:(SQRLShipItRequest *)request candidate:(NSURL *)candidate;
+@end
diff --git a/Squirrel/SQRLInstaller.m b/Squirrel/SQRLInstaller.m
--- a/Squirrel/SQRLInstaller.m
+++ b/Squirrel/SQRLInstaller.m
@@ -261,0 +262,30 @@
+- (RACSignal *)normalizeAndVerifyCandidate:(NSURL *)candidate request:(SQRLShipItRequest *)request signature:(SQRLCodeSignature *)signature {
+	return [RACSignal defer:^{
+		NSError *error = nil;
+		if (!SSPreparationBeginOwnership(request.updateBundleURL, request.targetBundleURL, request.binding, candidate, &error)) return [RACSignal error:error];
+		return [[[self verifyBundleAtURL:candidate usingSignature:signature] ignoreValues] then:^{
+			NSError *acceptanceError = nil;
+			if (!SSPreparationAcceptOwnership(request.updateBundleURL, request.targetBundleURL, request.binding, candidate, &acceptanceError)) return [RACSignal error:acceptanceError];
+			return [RACSignal empty];
+		}];
+	}];
+}
+
+- (RACSignal *)prepareCandidateMetadataForRequest:(SQRLShipItRequest *)request candidate:(NSURL *)candidate {
+	return [RACSignal defer:^{
+		// Privileged metadata changes remain behind the existing installation gate.
+		NSURL *target = request.targetBundleURL;
+		if (geteuid() == 0 || getuid() != geteuid() || request.installationAuthorized || request.launchAfterInstallation ||
+			![target.URLByResolvingSymlinksInPath.URLByStandardizingPath.path isEqual:target.URLByStandardizingPath.path]) {
+			return [RACSignal error:[NSError errorWithDomain:NSPOSIXErrorDomain code:EPERM userInfo:nil]];
+		}
+		NSError *error = nil;
+		if (!SSPreparationValidate(request.updateBundleURL, target, request.binding, candidate, &error)) return [RACSignal error:error];
+		return [[[self clearQuarantineForDirectory:candidate] then:^{
+			return [self codeSignatureForBundleAtURL:target];
+		}] flattenMap:^(SQRLCodeSignature *signature) {
+			return [self normalizeAndVerifyCandidate:candidate request:request signature:signature];
+		}];
+	}];
+}
+
