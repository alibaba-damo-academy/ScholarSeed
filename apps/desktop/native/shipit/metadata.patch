+static BOOL SSMissingSealedResources(NSError *error) {
+  if (![error.domain isEqual:SQRLCodeSignatureErrorDomain] || error.code != SQRLCodeSignatureErrorDidNotPass) return NO;
+  NSError *underlying = error.userInfo[NSUnderlyingErrorKey];
+  if (![underlying.domain isEqual:NSOSStatusErrorDomain] || underlying.code != errSecCSBadResource) return NO;
+  NSString *missingKey = (__bridge NSString *)kSecCFErrorResourceMissing;
+  id missing = underlying.userInfo[missingKey];
+  if (![missing isKindOfClass:NSURL.class] && !([missing isKindOfClass:NSArray.class] && [missing count] > 0)) return NO;
+  // Nested code and multi-architecture checks can add the failing component/architecture.
+  // Any other diagnostic (e.g. an altered or added resource) is a different failure.
+  for (NSString *key in underlying.userInfo) {
+    if (![key isEqual:missingKey] &&
+        ![key isEqual:(__bridge NSString *)kSecCFErrorPath] &&
+        ![key isEqual:(__bridge NSString *)kSecCFErrorArchitecture]) return NO;
+  }
+  return YES;
+}
