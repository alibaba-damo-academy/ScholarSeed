-                        if (occupied()) return [RACSignal error:[NSError errorWithDomain:SQRLInstallerErrorDomain code:SQRLInstallerErrorAppStillRunning userInfo:nil]];
-                        return [RACSignal empty];
-                    }];
+                return [[self normalizeAndVerifyCandidate:updateBundleURL request:request signature:codeSignature] then:^RACSignal *{
+                    if (occupied()) return [RACSignal error:[NSError errorWithDomain:SQRLInstallerErrorDomain code:SQRLInstallerErrorAppStillRunning userInfo:nil]];
+                    return [RACSignal empty];
+                }];
