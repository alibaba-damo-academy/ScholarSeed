{
  "extends": "./tsconfig.tools.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/markdown/**/*",
    "../../packages/ui/document.ts",
    "../../packages/ui/canvas.ts",
    "../../packages/ui/canvas.worker.ts",
    "../../packages/ui/canvases.tsx",
    "../../packages/ui/painter.tsx",
    "../../packages/ui/library.tsx",
    "../../packages/ui/charts.tsx",
    "../../packages/ui/renderer.tsx",
    "../../packages/ui/messages.ts",
    "../../packages/ui/validation.ts",
    "../../packages/ui/validation.worker.ts",
    "*.ts",
    "src/*.ts",
    "src/main/browser.ts",
    "src/main/favicon.ts",
    "src/main/cdp.ts",
    "src/main/chromium.ts",
    "src/main/chromiumdevtools.ts",
    "src/main/chromiumpolicy.ts",
    "src/main/chromiumregistry.ts",
    "src/main/chromiumtarget.ts",
    "src/main/clipboard.ts",
    "src/main/downloads.ts",
    "src/main/downloads-record.ts",
    "src/main/grant.ts",
    "src/main/history.ts",
    "src/main/history-record.ts",
    "src/main/inspector.ts",
    "src/main/journal.ts",
    "src/main/localization.ts",
    "src/main/navigation.ts",
    "src/main/network.ts",
    "src/main/page.ts",
    "src/main/pdf.ts",
    "src/main/searchform.ts",
    "src/main/skills.ts",
    "src/main/startupmarker.ts",
    "src/main/storage.ts",
    "src/main/storage-record.ts",
    "src/main/vault.ts",
    "src/main/vaultipc.ts",
    "src/main/vaultstorage.ts",
    "src/main/version.ts",
    "src/main/writer.ts",
    "src/renderer/**/*",
    "src/localization/**/*",
    "src/test-helpers/**/*",
    "preview/**/*",
    "e2e/**/*"
  ],
  "exclude": []
}
