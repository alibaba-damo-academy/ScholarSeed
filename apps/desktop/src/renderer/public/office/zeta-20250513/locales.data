op><prop oor:name="STR_INFO_PRIMARY"><value xml:lang="zh-CN">已成功更新演示文档「%TITLE」。</value></prop><prop oor:name="STR_INFO_SECONDARY_1"><value xml:lang="zh-CN">文件大小从 %OLDFILESIZE MB 变为 %NEWFILESIZE MB。</value></prop><prop oor:name="STR_INFO_SECONDARY_2"><value xml:lang="zh-CN">文件大小从 %OLDFILESIZE MB 变为大约 %NEWFILESIZE MB。</value></prop><prop oor:name="STR_INFO_SECONDARY_3"><value xml:lang="zh-CN">文件大小变为 %NEWFILESIZE MB。</value></prop><prop oor:name="STR_INFO_SECONDARY_4"><value xml:lang="zh-CN">文件大小变为大约 %NEWFILESIZE MB。</value></prop><prop oor:name="STR_DUPLICATING_PRESENTATION"><value xml:lang="zh-CN">正在复制演示文稿...</value></prop><prop oor:name="STR_DELETING_SLIDES"><value xml:lang="zh-CN">正在删除幻灯片···</value></prop><prop oor:name="STR_OPTIMIZING_GRAPHICS"><value xml:lang="zh-CN">正在优化图像...</value></prop><prop oor:name="STR_CREATING_OLE_REPLACEMENTS"><value xml:lang="zh-CN">正在创建 OLE 对象的替代图像...</value></prop><prop oor:name="STR_FILESIZESEPARATOR"><value xml:lang="zh-CN">.</value></prop><prop oor:name="STR_FILENAME_SUFFIX"><value xml:lang="zh-CN">(最小化)</value></prop><prop oor:name="STR_WARN_UNSAVED_PRESENTATION"><value xml:lang="zh-CN">是否希望最小化演示文稿而不保存?</value></prop></node><node oor:name="LastUsedSettings"><prop oor:name="Name"><value xml:lang="zh-CN">为投影仪优化</value></prop></node><node oor:name="Settings"><node oor:name="Templates"><node oor:name="template1"><prop oor:name="Name"><value xml:lang="zh-CN">电子邮件用 (96 DPI)：让文件尽可能小，以便分享</value></prop></node><node oor:name="template2"><prop oor:name="Name"><value xml:lang="zh-CN">网络用 (150 DPI)：适用于网页和投影仪</value></prop></node><node oor:name="template3"><prop oor:name="Name"><value xml:lang="zh-CN">打印用 (300 DPI)：适合绝大多数打印机以及屏幕显示的高质量</value></prop></node><node oor:name="template4"><prop oor:name="Name"><value xml:lang="zh-CN">高保真：保留原始图片的分辨率</value></prop></node></node></node></oor:component-data><oor:component-data xmlns:install="http://openoffice.org/2004/installation" oor:package="org.openoffice.Office" oor:name="PresenterScreen"><node oor