ngs"><node oor:name="a"><prop oor:name="Left"><value xml:lang="zh-CN">鼠标左键, 右/下箭头, 空格, Page Down 或回车 (换行) 键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">下一张幻灯片，或下一个效果</value></prop></node><node oor:name="b"><prop oor:name="Left"><value xml:lang="zh-CN">鼠标右键, 左/上箭头, Page Up 或退格键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">上一张幻灯片，或上一个效果</value></prop></node><node oor:name="c"><prop oor:name="Left"><value xml:lang="zh-CN">P 键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">把鼠标指针当作笔使用</value></prop></node><node oor:name="d"><prop oor:name="Left"><value xml:lang="zh-CN">Home 键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">第一张幻灯片</value></prop></node><node oor:name="e"><prop oor:name="Left"><value xml:lang="zh-CN">End 键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">最后一张幻灯片</value></prop></node><node oor:name="f"><prop oor:name="Left"><value xml:lang="zh-CN">E 键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">擦除幻灯片上的所有墨迹</value></prop></node><node oor:name="g"><prop oor:name="Left"><value xml:lang="zh-CN">Alt+PageUp</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">上一张幻灯片，无效果</value></prop></node><node oor:name="h"><prop oor:name="Left"><value xml:lang="zh-CN">Alt+PageDown</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">下一张幻灯片，无效果</value></prop></node><node oor:name="j"><prop oor:name="Left"><value xml:lang="zh-CN">B 和 . 键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">黑屏/取消黑屏</value></prop></node><node oor:name="k"><prop oor:name="Left"><value xml:lang="zh-CN">W 和 , 键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">白屏/取消白屏</value></prop></node><node oor:name="m"><prop oor:name="Left"><value xml:lang="zh-CN">Esc 或 - 键</value></prop><prop oor:name="Right"><value xml:lang="zh-CN">终止幻灯片放映</value></prop></node><node oor:name="o"><prop oor:name="Left"><value xml:lang="zh-CN">输入数字后按回车键</value></prop><prop oor:name="Right"><value xml:lang="zh