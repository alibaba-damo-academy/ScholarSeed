# Vendored Office runtime assets are byte-exact and digest-verified, so the
# whole tree defaults to binary and must never be text-normalized; new files
# added to any build directory are covered automatically. Only the notices
# markdown stays text. Large runtime assets are downloaded from reviewed OSS
# URLs and verified by their manifests; they are not tracked through Git LFS.
apps/desktop/src/renderer/public/office/** -text
# Preserve the already-reviewed Windows Office component bytes on every host.
apps/desktop/src/renderer/public/office/THIRD_PARTY_NOTICES.md -text
*.pdf binary
# Keep nested notice evidence byte-exact on Windows; root metadata stays LF.
apps/desktop/resources/notices/** -text
apps/desktop/resources/notices/*.json text eol=lf
apps/desktop/resources/notices/*.md text eol=lf

# These source bytes participate directly in reviewed content identities.
skills/community/** -text
apps/serve/service/capabilities/defaults/** -text
apps/desktop/scripts/cd/bytecode.py text eol=lf
uv.lock text eol=lf
apps/desktop/scripts/cd/legacy-files.json text eol=lf
apps/desktop/updater/cmd/setup/legacy-files.json text eol=lf

# Preserve literal CRLF test fixtures in source strings.
apps/desktop/scripts/cd/__tests__/verification.test.cjs -text

# ACL compiler receipts bind the exact source and generated output bytes.
apps/desktop/native/security.json text eol=lf
apps/desktop/native/security.outputs.json text eol=lf
apps/desktop/native/security.h text eol=lf
apps/desktop/updater/internal/security/evaluate.go text eol=lf
apps/serve/service/platform/security.py text eol=lf
packages/adapters/codex/scholarseed_codex/permissions.py text eol=lf
scripts/shared/security.cjs text eol=lf
