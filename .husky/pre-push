#!/usr/bin/env sh
# 只在本次推送触及 skills/** 时，对**被推送的提交树**（而不是可能脏的工作区）运行
# 只读的技能清单一致性校验。本钩子只失败、绝不修改任何文件——修复动作留给开发者。
#
# 为什么需要它：skills/community/*/.scholarseed-package.json 与 skills.lock.json、
# registry.json 的三方一致性，过去只有打包机 dependencies._inputs 会拦，反馈最晚最贵
# （09-28 precise-literature-search、09-29 research-idea-partner 两次三平台构建全挂）。
# CI 的 desktop-unit-test 跑同一条门禁，但要等流水线；这里在 push 前就给结论。
#
# 校验实现与 CI 共用 scripts/shared/skills.cjs，两边不会漂移。它收集全部违规后一次性报告，
# 因此一个坏技能不会遮蔽另一个。
#
# 生效前提：仓库 core.hookspath 指向 .husky/_（由根 package.json 的 prepare: husky 在
# npm install 时生成）。用 --ignore-scripts 安装的检出不会启用任何钩子，此时以 CI 为准。

zero=0000000000000000000000000000000000000000
checker=scripts/shared/skills.cjs

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] 找不到 node，跳过 skills 一致性校验（CI 仍会强制）" >&2
  exit 0
fi

# 对被推送的提交树跑校验：从该提交导出 skills/ 与校验器到临时目录后执行，
# 这样脏工作区既不会造成误报，也不会掩盖真正被推上去的坏状态。
verify_tip() {
  tip=$1
  # 校验器尚未存在于该提交（推送的是更早的历史）时无从校验，交给 CI。
  if ! git cat-file -e "$tip:$checker" 2>/dev/null; then
    return 0
  fi
  tmp=$(mktemp -d 2>/dev/null) || return 0
  if ! git archive "$tip" skills "$checker" 2>/dev/null | tar -x -C "$tmp" 2>/dev/null; then
    rm -rf "$tmp"
    return 0
  fi
  echo "[pre-push] 校验 $tip 的 skills/ 清单一致性..." >&2
  node "$tmp/$checker"
  status=$?
  rm -rf "$tmp"
  return $status
}

failed=0
checked=0
while read -r local_ref local_oid remote_ref remote_oid; do
  # 删除远端分支：无内容可校验。
  if [ "$local_oid" = "$zero" ]; then
    continue
  fi
  if [ "$remote_oid" != "$zero" ]; then
    # 已存在的远端分支：只在本次推送范围触及 skills/ 时才校验。
    touched=$(git diff --name-only "$remote_oid" "$local_oid" -- skills/ 2>/dev/null)
    if [ -z "$touched" ]; then
      continue
    fi
  fi
  # 新分支无法可靠确定基线，宁可多查一次（校验是只读的，成本约 0.1s）。
  checked=$((checked + 1))
  if ! verify_tip "$local_oid"; then
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "[pre-push] 已阻止推送：技能清单与 skills.lock.json / registry.json 不一致。" >&2
  echo "[pre-push] 按 skills/ADAPTATION.md §3 重新生成受影响技能的包清单并回写其 lock 行，" >&2
  echo "[pre-push] 再运行 node scripts/shared/skills.cjs 确认干净后重新推送。" >&2
  exit 1
fi

if [ "$checked" -gt 0 ]; then
  echo "[pre-push] skills/ 清单一致性校验通过" >&2
fi
exit 0
