                    "enum": [
                      "group",
                      "step"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Kind"
              }
            },
            "required": [
              "id",
              "content"
            ],
            "title": "PlanNode",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "plan_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Plan Id",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "turn_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Turn Id",
            "type": "string"
          },
          "reason": {
            "default": "",
            "maxLength": 512,
            "title": "Reason",
            "type": "string"
          },
          "operation": {
            "enum": [
              "create",
              "update",
              "revise",
              "release"
            ],
            "title": "Operation",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/PlanNode"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Items",
            "type": "array"
