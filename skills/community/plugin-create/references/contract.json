            "default": null,
            "title": "Slot"
          },
          "public": {
            "default": false,
            "title": "Public",
            "type": "boolean"
          },
          "entry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Package-relative compiled JavaScript component entry",
            "title": "Entry"
          },
          "preview": {
            "description": "Package-relative conversation scenario JSON",
            "title": "Preview",
            "type": "string"
          },
          "actions": {
            "items": {
              "$ref": "#/$defs/PluginAction"
            },
            "maxItems": 64,
            "title": "Actions",
            "type": "array"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "output_schema": {
            "additionalProperties": true,
            "title": "Output Schema",
            "type": "object"
          }
        },
        "required": [
          "id",
          "preview"
        ],
        "title": "PluginComponent",
        "type": "object"
      },
      "PluginConfiguration": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Key",
            "type": "string"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "boolean"
            ],
            "title": "Type",
            "type": "string"
          },
          "label": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "required": {
            "default": false,
            "title": "Required",
            "type": "boolean"
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Default"
          }
        },
        "required": [
          "key",
          "type",
          "label"
        ],
        "title": "PluginConfiguration",
        "type": "object"
      },
      "UIDependency": {
        "additionalProperties": false,
        "properties": {
          "compatibility": {
            "const": "1.0",
            "title": "Compatibility",
            "type": "string"
          },
          "exports": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "title": "Exports",
            "type": "array"
          }
        },
        "required": [
          "compatibility",
          "exports"
        ],
        "title": "UIDependency",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema": {
        "maximum": 2,
        "minimum": 2,
        "title": "Schema",
        "type": "integer"
      },
      "id": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "title": "Id",
        "type": "string"
      },
      "version": {
        "title": "Version",
        "type": "string"
      },
