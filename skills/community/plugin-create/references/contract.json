{
  "descriptor": ".scholarseed-plugin.json",
  "schema": {
    "$defs": {
      "PluginAction": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "capability": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
            "title": "Capability",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          }
        },
        "required": [
          "id",
          "capability"
        ],
        "title": "PluginAction",
        "type": "object"
      },
      "PluginComponent": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "slot": {
            "anyOf": [
              {
                "maxLength": 128,
