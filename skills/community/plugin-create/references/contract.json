        "default": null
      },
      "capabilities": {
        "items": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "maxItems": 64,
        "title": "Capabilities",
        "type": "array"
      },
      "components": {
        "items": {
          "$ref": "#/$defs/PluginComponent"
