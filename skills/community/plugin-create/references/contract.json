        "title": "PlanStructure",
        "type": "object",
        "x-bridge-guidance": "Read plan/get first. Send complete flat nodes without status. Existing execution states are preserved and new nodes are pending. Use plan/action for execution, not structure edits. Revision, identity and started-leaf constraints still apply.",
        "x-bridge-prerequisites": [
          {
            "capability": "plan",
            "operation": "get"
          }
        ]
      },
