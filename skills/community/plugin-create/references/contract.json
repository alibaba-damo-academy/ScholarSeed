              "status"
            ],
            "title": "PlanItem",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "request.operation is the plan mutation, not action; outer operation is always write.",
            "enum": [
              "create",
              "update",
              "revise",
              "release"
            ],
            "title": "Operation",
            "type": "string"
          },
          "plan_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Plan Id",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "turn_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Turn Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/PlanItem"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "reason": {
            "default": "",
            "maxLength": 512,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "operation",
          "plan_id",
          "expected_revision",
          "request_id",
          "turn_id",
          "items"
        ],
        "title": "PlanWrite",
        "type": "object",
        "x-bridge-guidance": "First call plan/get with request={} for the current turn_id, plan and revision. Call plan/write: outer operation is always write; request.operation is create, update, revise or release, not action. Create a new plan_id with expected_revision=0 only when no structured plan exists. Otherwise reuse plan_id and the current revision. Send complete flat items with stable ids and optional parent_id; Keep ids unchanged when renaming steps. Start each leaf with in_progress before performing its work; never batch pending leaves directly to completed. Parents aggregate child execution time, and parallel leaves may be in_progress together. Declare a container as kind=group before starting it; its children may be refined later. Groups only aggregate children and cannot complete without children. Refine an ordinary leaf before starting it, not after. No children field is supported. Use a new request_id per mutation, reusing it only for an identical retry, and the current turn_id. Update changes progress without changing root content or existing parent links. Revise changes structure and requires a non-empty reason. For normal completion, use update to mark finished items completed. Release opts out of structured planning, requires a non-empty reason and preserves items; it is not ordinary completion. On revision conflict, reread plan/get before a changed retry.",
        "x-bridge-prerequisites": [
          {
            "capability": "plan",
            "operation": "get"
          }
        ]
      },
