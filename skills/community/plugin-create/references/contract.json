        "maxItems": 64,
        "title": "Components",
        "type": "array"
      },
      "configuration": {
        "items": {
          "$ref": "#/$defs/PluginConfiguration"
        },
        "maxItems": 64,
        "title": "Configuration",
        "type": "array"
      }
