# Windows PowerShell: use paid-download.ps1 or references/windows.md instead.
# Source this file from zsh/bash before running the literature-search workflow:
#   source "$SKILL_DIR/config/paid-download.env"
#
# This tracked file contains no credentials. Keep passwords, cookies, and tokens
# out of it.

# Default interactive workflow.
export PAPER_DL_MODE="interactive"

# Browser-pool supports off only; Zotero modes are rejected.
export PAPER_DL_ZOTERO_MODE="off"

# Chrome or Edge is started and closed by a shared three-slot browser pool.
# Default profile: ${HOME}/.paper-dl-cdp-profile
# Parallel profiles: ${HOME}/.paper-dl-cdp-profile-pool/slot-1 and slot-2
# Lease/lock metadata stays in ${HOME}/.paper-dl/browser-pool.
# All skill copies on this machine must use the same pool root. A different
# explicit root retains isolated profiles at <root>/slot-N/profile.
# export PAPER_DL_BROWSER_POOL_DIR="${HOME}/.paper-dl/browser-pool"
# Optional offline login template for new slots only. The pool automatically
# uses <pool>/profile-template when present. Create it with browser_pool.py
# create-template --source-profile /path/to/closed/chrome-user-data-dir.
# export PAPER_DL_PROFILE_TEMPLATE="${HOME}/.paper-dl/browser-pool/profile-template"
# export PAPER_DL_CHROME_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# To select Edge explicitly, use /Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge.
# Edge profiles use <pool>/slot-N/edge-profile and default to <pool>/edge-profile-template.
# Create an Edge template with browser_pool.py create-template --browser edge
# --source-profile /path/to/closed/edge-user-data-dir.
# PAPER_DL_PROFILE_TEMPLATE overrides either default; use a template for the selected browser.
# export PAPER_DL_CDP_STARTUP_TIMEOUT="15"

# Install the runtime separately. The adapter discovers the Skill .venv or PATH.
# An explicit runtime can be configured below:
# export PAPER_DL_ROOT="/absolute/path/to/paper-dl-source"
# export PAPER_DL_EXECUTABLE="/absolute/path/to/paper-dl"

# Optional interactive timeout override (seconds).
# export PAPER_DL_PAPER_TIMEOUT="600"
# export PAPER_DL_BATCH_TIMEOUT="1800"

# Optional paper-dl settings. The pool always disables Zotero. The downloader
# ships without translator adapters; a reviewed YAML may explicitly point
# browser.translators_dir at a separately converted, trusted adapter directory.
# export PAPER_DL_CONFIG="/absolute/path/to/paper-dl-config.yaml"
# export PAPER_DL_EMAIL="name@example.org"

# Unattended mode uses the same owned CDP pool, skips login/CAPTCHA, and
# releases its browser after the batch. It must disable Zotero Desktop:
# export PAPER_DL_MODE="autodev"
# export PAPER_DL_ZOTERO_MODE="off"
