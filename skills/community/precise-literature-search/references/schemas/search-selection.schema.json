{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-selection.schema.json",
  "title": "Internal tiered selection for search finalization",
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [
          "related_recommendations"
        ],
        "properties": {
          "related_recommendations": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "selected": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "selected",
    "coverage_assessment",
    "warnings"
  ],
  "properties": {
    "related_recommendations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "unmet_criteria",
          "scope_key",
          "evidence_key",
          "confirmed_connections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "scope_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "unmet_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "criterion_key",
                "reason",
                "status"
              ],
              "properties": {
                "criterion_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "status": {
                  "enum": [
                    "unmet",
                    "unverified"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "confirmed_connections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement",
                "evidence"
              ],
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": [
                      "field",
                      "quote"
                    ],
                    "properties": {
                      "field": {
                        "enum": [
                          "title",
                          "abstract",
                          "year",
                          "language",
                          "publication_type",
                          "publication_types"
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "schema_version": {
      "const": "1.0"
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "relevance_score",
          "selection_reason",
          "subtopics_covered"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "relevance_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "selection_reason": {
            "type": "string"
          },
          "subtopics_covered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intent_review": {
            "type": "object",
            "allOf": [
              {
                "if": {
                  "required": [
                    "schema_version"
                  ],
                  "properties": {
                    "schema_version": {
                      "const": "1.1"
                    }
                  }
                },
                "then": {
                  "required": [
                    "scope_key",
                    "evidence_key"
                  ]
                }
              }
            ],
            "required": [
              "intent_key",
              "eligible",
              "reason"
            ],
            "properties": {
              "schema_version": {
                "const": "1.1"
              },
              "scope_key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evidence_key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "criterion_key",
                    "verdict",
                    "reason"
                  ],
                  "properties": {
                    "criterion_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verdict": {
                      "enum": [
                        "supports",
                        "clear",
                        "unknown",
                        "contradicts"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "required": [
                          "field",
                          "quote"
                        ],
                        "properties": {
                          "field": {
                            "type": "string",
                            "minLength": 1
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "source": {
                            "type": "string"
                          },
                          "locator": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "maxItems": 64
              },
              "intent_key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "eligible": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              },
              "year": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              },
              "year_source": {
                "type": "string",
                "pattern": "\\S"
              },
              "verification_status": {
                "const": "candidate",
                "description": "Search handoff; full-text verification is performed during reading."
              }
            }
          }
        }
      }
    },
    "coverage_assessment": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
