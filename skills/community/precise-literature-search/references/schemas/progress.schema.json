{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress.schema.json",
  "title": "Run-wide user-visible progress",
  "type": "object",
  "required": [
    "schema_version", "sequence", "stage", "status", "activity",
    "current", "total", "completed", "needs_user_action", "action",
    "started_at", "updated_at", "elapsed_seconds"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["search", "download", "reading", "reporting"]},
    "status": {"enum": ["running", "action_required", "completed", "failed", "cancelled"]},
    "activity": {"type": "string", "minLength": 1},
    "current": {"type": ["integer", "null"], "minimum": 0},
    "total": {"type": ["integer", "null"], "minimum": 0},
    "completed": {"type": ["integer", "null"], "minimum": 0},
    "needs_user_action": {"type": "boolean"},
    "action": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "elapsed_seconds": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
