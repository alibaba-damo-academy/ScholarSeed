{
  "name": "scholarseed-workspace",
  "version": "0.3.1",
  "private": true,
  "description": "ScholarSeed workspace command wrapper",
  "license": "Apache-2.0",
  "scripts": {
    "ops": "node scripts/ops-cli.cjs",
    "dev": "node scripts/ops-cli.cjs cd build local --target skills && node scripts/ops-cli.cjs dev",
    "package:dist": "node scripts/desktop.cjs package:dist",
    "package:check": "node scripts/desktop.cjs package:check",
    "package:verify": "node scripts/desktop.cjs package:verify",
    "postinstall": "node scripts/pre/toolchain.cjs ensure",
    "prepare": "husky",
    "all": "node scripts/shared/workspace.cjs all",
    "start": "node scripts/shared/workspace.cjs run",
    "desktop": "node scripts/shared/workspace.cjs desktop",
    "trace-ui": "node scripts/shared/workspace.cjs trace-ui",
    "trace-ui:stop": "node scripts/shared/workspace.cjs trace-ui-stop",
    "ui-find": "node scripts/shared/workspace.cjs ui-find",
    "install:cmd": "node scripts/shared/workspace.cjs install-cmd",
    "uninstall:cmd": "node scripts/shared/workspace.cjs uninstall-cmd",
    "user-data:preview": "node scripts/shared/workspace.cjs user-data:preview",
    "user-data:delete": "node scripts/shared/workspace.cjs user-data:delete"
  },
  "engines": {
    "node": "24.16.0"
  },
  "toolchain": {
    "defaultPackageManager": "pnpm@12.14.0"
  },
  "devDependencies": {
    "husky": "9.1.7"
  }
}
