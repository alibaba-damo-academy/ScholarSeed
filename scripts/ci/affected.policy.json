{
  "schemaVersion": 1,
  "fallbackCommand": "pnpm ops ci test --profile quality",
  "fallbackReason": "映射不到定向测试时升级 L2（offline profile，自动启用 quarantine 快速通道）",
  "pythonSuites": {
    "discoverModule": "tests.run_all",
    "discoverAttr": "SUITES"
  },
  "limits": {
    "maxPythonSuitesPerCommand": 12,
    "ipcFilePattern": "\\b(ipc|preload|handoff|bridge)\\b"
  },
  "supplements": [
    {
      "id": "official-ui-shared-resources",
      "match": "^(?:packages/ui/(?:ui\\.css|(?:build|render)\\.test\\.cjs|preview/browser\\.test\\.cjs)|apps/desktop/src/renderer/src/(?:components/primitive/(?:utils\\.ts|Gallery\\.tsx|Images\\.tsx)|features/literature/(?:Matches\\.tsx|export\\.ts)))$",
      "tests": [
        "packages/ui/build.test.cjs",
        "packages/ui/render.test.cjs",
        "packages/ui/preview/browser.test.cjs"
      ]
    },
    {
      "id": "desktop-shared-card-styles",
      "match": "^apps/desktop/src/renderer/src/components/primitive/utils\\.ts$",
      "tests": [
        "apps/desktop/src/renderer/src/components/markdown.render.test.ts"
      ]
    },
    {
      "id": "desktop-shared-image-preview",
      "match": "^apps/desktop/src/renderer/src/components/primitive/(?:Gallery|Images)\\.tsx$",
      "tests": [
        "apps/desktop/src/renderer/src/features/assistant/Images.render.test.ts",
        "apps/desktop/src/renderer/src/components/primitive/images.render.test.cjs"
      ]
    }
  ],
  "rules": [
    {
      "id": "desktop-adjacent-unit",
      "match": "^apps/desktop/.+\\.(ts|tsx|js|mjs|cjs)$",
      "command": "cd apps/desktop && node --experimental-transform-types --test {files}",
      "resolve": "adjacentTest",
      "onMiss": "consumerImportScan"
    },
    {
      "id": "serve-python-contracts",
      "match": "^apps/serve/service/.+\\.py$",
      "command": ".venv/bin/python -m tests.run_all --only-suite {suites}",
      "cwd": "apps/serve",
      "env": { "PYTHONPATH": "{root}" },
      "resolve": "pythonSuiteBySourceStem"
    },
    {
      "id": "root-python-contracts",
      "match": "^tests/(contract|release|integration)/.+\\.py$|^packages/.+\\.py$",
      "command": ".venv/bin/python -m tests.run_all --only-suite {suites}",
      "cwd": "apps/serve",
      "env": { "PYTHONPATH": "{root}" },
      "resolve": "pythonSuiteBySourceStem"
    }
  ],
  "ipc": {
    "channelPattern": "(?:ipcMain\\.handle|webContents\\.send)\\(\\s*['\"]([^'\"]+)['\"]",
    "consumerPatterns": ["ipcRenderer\\.invoke\\(\\s*['\"]{channel}['\"]", "invoke\\(\\s*['\"]{channel}['\"]"],
    "scanRoots": ["apps/desktop/src"]
  }
}
