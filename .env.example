# ScholarSeed 本地环境变量示例
# 按实际源码整理：开发工具、Desktop/Serve、独立技能、维护者构建。
# 所有赋值默认注释；只取消所需项的注释并替换示例。未配置请保持注释，
# 不要批量写 KEY=：空值也可能阻止 setdefault / Make ?= 生效或造成数字解析错误。
# 仓库 .gitignore 已忽略 .env；这里只保存示例，不填写真实凭据。
# 已有 .env 时手动合并所需条目，不要用本文件覆盖它。
#
# 加载方式（在仓库根目录；现有 Make / Python 产品入口未统一自动加载 .env）：
# macOS bash/zsh，安装好依赖后，在子 shell 内导出，再启动：
#   (set -a; . ./.env; set +a; make desktop)
# Windows PowerShell，安装好依赖后，使用 uv 的 dotenv 加载器：
#   uv run --no-sync --env-file .env -- scholarseed-desktop
# 单独运行技能时，也必须在加载变量的进程中启动对应命令。
# 给 Codex/Claude 的开发技能使用时，需要由宿主启动环境或显式加载器传入；
# 在已运行宿主之外修改 shell 环境不会更新宿主。双击已安装 Desktop 也不读本文件。
# macOS 路径用绝对路径；Windows 推荐 C:/Users/your-name/...，含空格加引号。
# 示例避免 shell 插值，便于 dotenv 跨平台解析；不要把 .env 作为可执行脚本编辑。

# 1. 开发工具凭据：适合本地 .env
# --------------------------------
# 内部开发 Skill 的平台凭据由文档内源仓管理，不作为产品运行配置。

# 2. 检索凭据：独立技能可配置；Desktop 优先通过登录自动注入
# -----------------------------------------------------------
# PaperHub / 书深 API Key：agentic-search、fast-search、precise-literature-search。
# 获取：登录书深，进入账号设置中的 API Key 管理，新建个人 key 并保存生成时明文；
# 没有服务访问权限时向服务管理员申请。这里不提供可用凭据。
# Desktop 已登录会话通常自动获取托管技能 key；显式环境 key 也须通过身份检查，
# 不会替代产品登录。独立运行技能时，才通常需要手动配置。
# 消费者：apps/serve/service/identity/service/skill_credentials.py、各技能 paperhub.py
# SCHOLARSEED_API_KEY='your-personal-paperhub-api-key'

# Brave Search：agentic-search 的 Brave HTTP 搜索工具，可选。
# 获取：https://brave.com/search/api/ 注册服务，在 https://api.search.brave.com/ 管理 key。
# 消费者：skills/community/agentic-search/tools/brave.py
# BRAVE_API_KEY='your-brave-search-api-key'

# 3. 本机目录和开发连接：适合按需配置
# ----------------------------------
# 获取方法：自己选择本机目录或向所连接服务的维护者索取 URL。
# SCHOLARSEED_HOME 默认 ~/.scholarseed，保存用户配置、凭据及跨项目状态。
# 更换它相当于选择另一套用户状态，不是迁移原数据。
# SCHOLARSEED_DEFAULT_WORKSPACE 用于默认工作区初始化，不会强制覆盖已有工作区注册状态。
# 消费者：service/brand.py、service/paths.py、service/bootstrap.py、Desktop backend.ts
# SCHOLARSEED_HOME='/absolute/path/to/scholarseed-home'
# SCHOLARSEED_DEFAULT_WORKSPACE='/absolute/path/to/project'

# 默认由 SCHOLARSEED_HOME 派生；仅需要独立存储时覆盖。
# DAMOATRACE_HOME 在 ScholarSeed 中默认同 SCHOLARSEED_HOME，单独运行 Trace 默认 ~/.damoatrace。
# DAMOATRACE_LEDGER_ROOT 在 ScholarSeed 中默认 <SCHOLARSEED_HOME>/projects。
# SCHOLARSEED_CODEX_HOME 默认 <SCHOLARSEED_HOME>/codex。
# 消费者：packages/damoatrace/damoatrace/paths.py、scholarseed_codex/environment.py
# DAMOATRACE_HOME='/absolute/path/to/trace-home'
# DAMOATRACE_LEDGER_ROOT='/absolute/path/to/trace-ledgers'
# SCHOLARSEED_CODEX_HOME='/absolute/path/to/scholarseed-codex-home'

# 设置后 Desktop 会 attach 到这个已运行 Serve，而不新建自己的后端。
# URL 来自目标 Serve 的实际监听地址；下面只是默认端口示例，不要默认启用。
# SCHOLARSEED_SERVE_URL='http://127.0.0.1:8770'
# 日志级别接受 debug/info/warning/error/critical（以 service/cli/serve.py 为准）。
# SCHOLARSEED_LOG_LEVEL='info'
# 仅 renderer 开发 URL + 非 headless 模式可启用 DevTools；make desktop-dev 已提供默认值。
# SCHOLARSEED_DEVTOOLS='1'

# 以下只用于直接启动 Serve 的身份策略；Desktop 显式传 off/machine，优先于环境。
# --auth-mode 优先于 SCHOLARSEED_AUTH_MODE；默认 auto，其他值 off/local/account。
# SCHOLARSEED_AUTH_MODE='local'
# ownership 允许 machine/account；按目标服务的身份归属需求选择。
# SCHOLARSEED_OWNERSHIP_AXIS='machine'
# 账号服务 URL 从产品配置/管理员获取，必须是自己信任的服务。
# 不要误当作模型 API 的 Base URL。
# SCHOLARSEED_ACCOUNT_BASE_URL='https://accounts.example.com'

# 4. 网络与检索配置：可选，本机值优先于技能 JSON 中相应设置
# ---------------------------------------------------------
# 代理地址从本机代理程序或网络管理员获取；端口必须用自己的实际值。
# 不同客户端的代理策略不同，这些变量不保证影响所有 HTTP 请求或托管 web search。
# HTTP_PROXY='http://127.0.0.1:7890'
# HTTPS_PROXY='http://127.0.0.1:7890'
# NO_PROXY='localhost,127.0.0.1,::1'

# 获取方法：复制技能自带 tools/search_config.example.json 到个人配置目录并修改，
# 这里填它的绝对路径。默认用户配置是 ~/.config/agentic-search/search_config.json。
# 消费者：skills/community/{agentic-search,fast-search}/tools/localconf.py
# AGENTIC_SEARCH_CONFIG='/absolute/path/to/search_config.json'
# PaperHub 代理模式：auto/off/on；auto 可在代理失败时尝试直连，off 为直连。
# PAPERHUB_PROXY_MODE='auto'
# 精确搜索请求超时，单位秒，必须为正整数；源码默认 60。
# PAPERHUB_SEARCH_TIMEOUT='60'
# 缓存默认未开启；选择本机缓存目录后启用。模式 readwrite/readonly/refresh/off。
# SEARCH_CACHE_DIR='/absolute/path/to/search-cache'
# SEARCH_CACHE_MODE='readwrite'

# PAPERHUB_URL、PAPERHUB_SEARCH_URL 虽有读取点，但部分技能限制为已审核 HTTPS
# origin/path，不能作为任意服务切换入口；优先使用技能内置地址，不在此复制部署地址。
# TEXT_BASE_URL、IMAGE_BASE_URL 是 SLR 技能网关参数，也受 transport.py 信任列表限制，
# 不是 Desktop 的通用模型连接入口。检索服务和模型服务 URL 不可互换。
# SLR 的 qwen/idealab 配置分别读取以下变量；地址应由组织网关管理员提供。
# TEXT_BASE_URL='https://gateway.example.com/v1'
# IMAGE_BASE_URL='https://gateway.example.com/v1'
# OPENAI_API_KEY 仅作为 models.py 对 OpenAI provider 的通用 fallback；个人连接优先
# 使用 Desktop 设置页保存的凭据，避免同一 key 被错误带到另一个 endpoint。
# OPENAI_API_KEY='your-openai-compatible-api-key'

# Trace 全局开关（变量名沿用 damoatrace 兼容协议，虽然产品路径已归 Trace 包）。
# 值：ON/JSONL（默认记录）、OFF、LOGGER、MEMORY、COMBO；server 单独 ON/OFF。
# DAMOAGENT_TRACE='ON'
# DAMOAGENT_TRACE_SERVER='ON'

# 5. 文献下载的本机配置：按需选择，完整示例归技能持有
# --------------------------------------------------
# 来源：skills/community/precise-literature-search/config/paid-download.env
# Windows 对照同目录 paid-download.ps1；这些文件不能原样当作通用 dotenv 导入。
# Chrome 路径从本机安装位置获取；默认会自动发现，不需要重复设置。
# PAPER_DL_CHROME_EXECUTABLE='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
# Windows 示例值：C:/Program Files/Google/Chrome/Application/chrome.exe
# 浏览器池默认使用 ~/.paper-dl/browser-pool；同机技能副本应使用同一池。
# PAPER_DL_BROWSER_POOL_DIR='/absolute/path/to/shared-browser-pool'
# 模板必须通过技能 browser_pool.py create-template 从已关闭的 Chrome profile 创建；
# 填生成的模板目录。登录 cookies 保留在本机 profile，不能复制进 .env。
# PAPER_DL_PROFILE_TEMPLATE='/absolute/path/to/profile-template'
# PAPER_DL_EMAIL='your-name@example.com'
# 模式 interactive/autodev；浏览器池当前只支持 Zotero off。
# PAPER_DL_MODE='interactive'
# PAPER_DL_ZOTERO_MODE='off'
# 可选超时，单位秒；以下为示例覆盖值。
# PAPER_DL_CDP_STARTUP_TIMEOUT='15'
# PAPER_DL_PAPER_TIMEOUT='600'
# PAPER_DL_BATCH_TIMEOUT='1800'
# 不要设置 PAPER_DL_CDP_ENDPOINT / PAPER_DL_CDP_PROFILE：当前共享池会拒绝旧覆盖。

# 6. 维护者构建变量：适合专用构建环境；日常开发无需配置
# ----------------------------------------------------
# 可执行文件位置用 command -v uv（macOS）或 (Get-Command uv).Source（PowerShell）获取；
# 实际版本需符合 pyproject.toml。Python/Node/Codex 版本由仓库清单管理。
# UV='/absolute/path/to/uv'
# VENV='/absolute/path/to/venv'
# SCHOLARSEED_PYTHON 虽可覆盖路径，Desktop 仍检查发行来源；不是任意 Python 替换开关。
# Desktop / make serve 采用仓库审核 Codex，忽略宿主 SCHOLARSEED_CODEX_EXECUTABLE 覆盖。

# Desktop 正式发行入口（pnpm ops cd build release）读取以下变量。本地 `pnpm ops dev` 与 `pnpm ops cd` 不需要。
# SCHOLARSEED_UPDATE_BASE_URL='https://updates.example.com/'
# SCHOLARSEED_MACOS_TEAM_ID='ABCDEFGHIJ'

# macOS 公证（与代码签名证书不同）：优先用已有 Keychain profile 的名字。
# 获取：构建机用 xcrun notarytool store-credentials 保存账号凭据后取得 profile 名；
# 或从 App Store Connect → 用户和访问 → 集成中的 API 密钥取得 .p8、Key ID、Issuer ID。
# 二选一；SCHOLARSEED_APPLE_API_KEY 是 .p8 文件路径，不是私钥内容。
# 消费者：apps/desktop/scripts/cd/notarize.cjs
# SCHOLARSEED_NOTARY_KEYCHAIN_PROFILE='your-notary-profile'
# SCHOLARSEED_APPLE_API_KEY='/absolute/path/to/AuthKey_YOURKEYID.p8'
# SCHOLARSEED_APPLE_API_KEY_ID='YOURKEYID'
# SCHOLARSEED_APPLE_API_ISSUER='your-issuer-uuid'

# Windows 签名：由签名服务管理员提供客户端、服务地址、域、账号、密钥及发布者名称。
# 只在 Windows 构建环境注入，CI 使用 secret store；不能照抄他人或内部部署凭据。
# 消费者：apps/desktop/scripts/cd/windows-sign.cjs；操作流程见 docs/runbooks/build.md。
# SCHOLARSEED_WINDOWS_SIGN_CLIENT='C:/signing/sign-client.cmd'
# SCHOLARSEED_WINDOWS_SIGN_SERVER='https://signing.example.com'
# SCHOLARSEED_WINDOWS_SIGN_DOMAIN='your-signing-domain'
# SCHOLARSEED_WINDOWS_SIGN_USER='your-signing-account'
# SCHOLARSEED_WINDOWS_SIGN_KEY='your-signing-secret'
# SCHOLARSEED_WINDOWS_SIGN_PUBLISHER='Your Organization'

# 7. 不建议纳入根 .env 的配置和运行时变量
# --------------------------------------
# 模型 provider/base_url/model_name/api_key：使用 Desktop「设置 → 模型服务」的个人
# model_profiles.json，或已有 config.json 配置链，不把所有连接拍平成环境变量。
# models.py 的部分内置配置路径支持 api_key_env / api_key_env_fallbacks /
# base_url_env 及 OPENAI_API_KEY 等 provider fallback，但个人模型连接不会因此
# 自动建立。不要把这些变量误写成启动必填项，也不要把模型 key 直接用于内置网关。
# SCHOLARSEED_MODEL_API_KEY、SCHOLARSEED_MODEL_HEADER_*：由产品从已选模型连接动态投影。
# SCHOLARSEED_ACCOUNT_TOKEN：当前登录身份的 JWT，由产品按会话注入并更新，不适合长期保存。
# SCHOLARSEED_AUTH_TOKEN：本地/远程 Serve CLI 认证 token，优先使用登录后的个人凭据存储；
# 它与上面的账号 JWT、PaperHub key、模型 key 含义不同。
# SCHOLARSEED_HOST_PROCESS_KEY、SCHOLARSEED_BRIDGE_TOKEN、SCHOLARSEED_BRIDGE_SESSION、
# SCHOLARSEED_BRIDGE_SOCKET、SCHOLARSEED_INTERNAL_BASE_URL：启动或会话内部通信数据。
# SCHOLARSEED_APP_VERSION、SCHOLARSEED_BUILD_CONTEXT、SCHOLARSEED_CONFIG_SEED_PATH、
# SCHOLARSEED_PRODUCT_MANIFEST、SCHOLARSEED_BUNDLE_*：由产品/构建入口和清单产生。
# SCHOLARSEED_SHOOT_SCENES、SCHOLARSEED_LIVE_TURN_TIMEOUT_MS、SCHOLARSEED_WORKBENCH_*、
# SEARCH_CACHE_REPLAY_TIMING、SLR_WORKSPACE：按测试/任务运行传入，避免全局污染。
# SCHOLARSEED_PROJECT_DIRNAME：项目状态路径协议，通常保留默认 .scholarseed。
# 匿名技能广场；由 Serve 读取，修改后重启应用，不携带账号凭据。
# SCHOLARSEED_CLAWHUB_URL='https://scholarseed.damo.alibaba.com/skillhub/'
# 跨域下载仅允许 HTTPS 与显式列出的主机（逗号分隔），不会转发服务 Cookie。
# SCHOLARSEED_CLAWHUB_DOWNLOAD_HOSTS='deep-rd.oss-cn-hangzhou.aliyuncs.com'
# HTTP 服务无法保证传输完整性，生产部署应配置 HTTPS。
# SCHOLARSEED_SKILLHUB_URL/TOKEN/TOKEN_FILE：仅遗留显式 Registry HTTP 工具读取；当前
# 应用运行时不用它，离线预制技能/打包也不需要它，不应放进通用启动模板。
# MCP OAuth、Codex OAuth、浏览器 cookies：由宿主凭据存储/Keychain/profile 管理。
# product.json、技能 registry/lock、工具链版本清单：共享产品声明，继续版本管理。
# 发布脚本当前从个人 config.json 读取管理员配置；在 .env 虚构同名项不会生效。
